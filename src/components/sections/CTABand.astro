---
import Icon from '../ui/Icon.astro';

export interface Props {
  kicker?: string;
  title?: string;
  text?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  variant?: 'dark' | 'light' | 'red';
  /** Tightens the padding and type. For pages that already close with a lot of content. */
  compact?: boolean;
}

const {
  kicker = "Let's talk",
  title = "Send us your drawings — we'll take it from there.",
  text = 'From RFQ to first article to volume supply. Upload a PDF, DWG, DXF or STEP file and we will come back within one working day.',
  primaryCta = { label: 'Request a quote', href: '/rfq' },
  secondaryCta = { label: 'Contact us', href: '/contact' },
  variant = 'dark',
  compact = false,
} = Astro.props;
---

<section
  class:list={[
    'cta-band',
    `cta-band--${variant}`,
    compact && 'cta-band--compact',
    variant !== 'light' && 'on-dark',
  ]}
>
  <div class="container cta-band__inner" data-reveal>
    <div>
      <p class="eyebrow">{kicker}</p>
      <h2 class="cta-band__title">{title}</h2>
      <p class="cta-band__text">{text}</p>
    </div>
    <div class="cta-band__actions">
      <a href={primaryCta.href} class={`btn btn--lg ${variant === 'red' ? 'btn--light' : 'btn--primary'}`}>
        {primaryCta.label}
        <Icon name="arrow-right" size={18} class="icon-arrow" />
      </a>
      {secondaryCta && <a href={secondaryCta.href} class="btn btn--outline btn--lg">{secondaryCta.label}</a>}
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--section-y);
  }

  /* Roughly half the height: the band is a signpost, not a section. */
  .cta-band--compact {
    padding-block: clamp(2.25rem, 1.4rem + 3vw, 3.5rem);
  }

  .cta-band--compact .cta-band__title {
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 1.875rem);
    max-width: 26ch;
    margin-bottom: var(--sp-3);
  }

  .cta-band--compact .cta-band__text {
    font-size: var(--fs-sm);
    max-width: 62ch;
  }

  .cta-band--compact .cta-band__inner {
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .cta-band--light {
    background: var(--ink-050);
    border-top: 1px solid var(--border);
  }

  .cta-band--red {
    background: var(--ge-red-ink);
    --border: rgba(255, 255, 255, 0.28);
    --border-strong: rgba(255, 255, 255, 0.45);
  }

  .cta-band--red :global(.eyebrow) {
    color: rgba(255, 255, 255, 0.9);
  }

  .cta-band--red :global(.eyebrow::before) {
    background: #fff;
  }

  .cta-band__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    align-items: center;
  }

  @media (max-width: 880px) {
    .cta-band__inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .cta-band__title {
    font-size: clamp(1.625rem, 1.2rem + 2vw, 2.5rem);
    max-width: 20ch;
    margin: 0 0 var(--sp-4);
  }

  .cta-band--dark .cta-band__title,
  .cta-band--red .cta-band__title {
    color: #fff;
  }

  .cta-band__text {
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--text-muted);
    max-width: 56ch;
    margin: 0;
  }

  .cta-band--red .cta-band__text {
    color: rgba(255, 255, 255, 0.85);
  }

  .cta-band__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
</style>

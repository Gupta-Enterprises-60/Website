---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/ge-logo.png';
import Icon from '../ui/Icon.astro';
import { navigation, site } from '../../lib/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || (href !== '/' && path.startsWith(href + '/')) || path === href;
---

<header class="site-header" data-header>
  <!-- Utility strip: credentials and direct contact, always one click away. -->
  <div class="utility">
    <div class="container utility__inner">
      <p class="utility__creds">
        <span class="utility__badge">ISO 9001:2015</span>
        <span class="utility__sep" aria-hidden="true">·</span>
        <span>Precision sheet-metal &amp; tubular components since {site.founded}</span>
      </p>
      <div class="utility__links">
        <a href={`tel:${site.contact.phonesE164[0]}`}>
          <Icon name="phone" size={14} />
          <span>{site.contact.phones[0]}</span>
        </a>
        <a href={`mailto:${site.contact.email}`}>
          <Icon name="mail" size={14} />
          <span>{site.contact.email}</span>
        </a>
      </div>
    </div>
  </div>

  <div class="bar">
    <div class="container bar__inner">
      <a href="/" class="brand" aria-label={`${site.name} — home`}>
        <Image src={logo} alt="" width={168} height={95} class="brand__mark" loading="eager" />
        <span class="brand__name">
          <span class="brand__light">Gupta</span><span class="brand__bold">Enterprises</span>
        </span>
      </a>

      <nav class="nav" aria-label="Primary">
        <ul class="nav__list">
          {
            navigation.map((group) => (
              <li class:list={['nav__item', group.columns && 'has-mega']}>
                <a
                  href={group.href}
                  class="nav__link"
                  aria-current={isActive(group.href ?? '') ? 'page' : undefined}
                  aria-expanded={group.columns ? 'false' : undefined}
                >
                  {group.label}
                  {group.columns && <Icon name="chevron-down" size={15} class="nav__caret" />}
                </a>

                {group.columns && (
                  <div class="mega" data-mega>
                    <div class="container mega__inner">
                      <div class="mega__cols">
                        {group.columns.map((col) => (
                          <div class="mega__col">
                            <p class="mega__title">{col.title}</p>
                            <ul>
                              {col.links.map((link) => (
                                <li>
                                  <a href={link.href} class="mega__link">
                                    <span class="mega__label">
                                      {link.label}
                                      <Icon name="arrow-right" size={14} />
                                    </span>
                                    {link.description && <span class="mega__desc">{link.description}</span>}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>

                      {group.feature && (
                        <aside class="mega__feature">
                          <p class="mega__feature-title">{group.feature.title}</p>
                          <p class="mega__feature-text">{group.feature.text}</p>
                          <a href={group.feature.href} class="link-arrow">
                            {group.feature.cta}
                            <Icon name="arrow-right" size={15} />
                          </a>
                        </aside>
                      )}
                    </div>
                  </div>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="bar__actions">
        <a href="/rfq" class="btn btn--primary btn--sm cta-quote">
          Request a quote
          <Icon name="arrow-right" size={16} class="icon-arrow" />
        </a>
        <button
          type="button"
          class="burger"
          data-drawer-open
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-drawer"
        >
          <Icon name="menu" size={22} />
        </button>
      </div>
    </div>
  </div>

  {/* Reading progress. Driven entirely by scroll(), so it costs no script. */}
  <div class="scroll-progress" aria-hidden="true"></div>
</header>

<!-- Mobile drawer -->
<div class="drawer" id="mobile-drawer" data-drawer hidden>
  <div class="drawer__head">
    <span class="drawer__title">Menu</span>
    <button type="button" class="drawer__close" data-drawer-close aria-label="Close menu">
      <Icon name="x" size={22} />
    </button>
  </div>

  <nav class="drawer__nav" aria-label="Mobile">
    <ul>
      {
        navigation.map((group) =>
          group.columns ? (
            <li class="drawer__group">
              <button type="button" class="drawer__toggle" aria-expanded="false">
                <span>{group.label}</span>
                <Icon name="chevron-down" size={18} />
              </button>
              <div class="drawer__panel" hidden>
                {group.href && (
                  <a href={group.href} class="drawer__overview">
                    {group.label} overview
                    <Icon name="arrow-right" size={14} />
                  </a>
                )}
                {group.columns.map((col) => (
                  <div class="drawer__sub">
                    <p class="drawer__subtitle">{col.title}</p>
                    <ul>
                      {col.links.map((link) => (
                        <li>
                          <a href={link.href}>{link.label}</a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            </li>
          ) : (
            <li>
              <a href={group.href} class="drawer__top">
                {group.label}
              </a>
            </li>
          )
        )
      }
    </ul>
  </nav>

  <div class="drawer__foot">
    <a href="/rfq" class="btn btn--primary btn--block">Request a quote</a>
    <a href={`tel:${site.contact.phonesE164[0]}`} class="drawer__contact">
      <Icon name="phone" size={16} />
      {site.contact.phones[0]}
    </a>
    <a href={`mailto:${site.contact.email}`} class="drawer__contact">
      <Icon name="mail" size={16} />
      {site.contact.email}
    </a>
  </div>
</div>
<div class="drawer-scrim" data-drawer-scrim hidden></div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--white);
  }

  /* Sits on the header's bottom edge. The scaleX is animated off the root
     scroll timeline in system.css; without support it stays at scaleX(0) and
     is simply never seen. */
  .scroll-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--ge-red);
    transform: scaleX(0);
    transform-origin: 0 50%;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-progress {
      display: none;
    }
  }

  /* ---- Utility strip --------------------------------------------------- */

  .utility {
    background: var(--ink-900);
    color: var(--ink-300);
    font-size: var(--fs-xs);
  }

  .utility__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    min-height: 38px;
    padding-block: 0.4rem;
  }

  .utility__creds {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    min-width: 0;
  }

  .utility__badge {
    color: #fff;
    font-weight: 600;
    letter-spacing: 0.04em;
    border-left: 3px solid var(--ge-red);
    padding-left: 0.5rem;
  }

  .utility__sep {
    color: var(--ink-600);
  }

  .utility__links {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    flex: none;
  }

  .utility__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--ink-300);
    text-decoration: none;
    white-space: nowrap;
  }

  .utility__links a:hover {
    color: #fff;
  }

  @media (max-width: 940px) {
    .utility__creds span:not(.utility__badge),
    .utility__sep {
      display: none;
    }
  }

  @media (max-width: 620px) {
    .utility__links a span {
      display: none;
    }
    .utility__links {
      gap: var(--sp-4);
    }
  }

  /* ---- Main bar --------------------------------------------------------- */

  .bar {
    border-bottom: 1px solid var(--border);
    transition: box-shadow var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  :global(.site-header.is-stuck) .bar {
    box-shadow: 0 1px 12px rgba(11, 13, 16, 0.08);
    border-color: transparent;
  }

  .bar__inner {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    min-height: var(--header-h);
  }

  /* ---- Brand ------------------------------------------------------------ */

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    flex: none;
    margin-right: auto;
  }

  /* Rendered at 84px against a 76px-tall bar. The asset is emitted at 2x so
     the mark stays crisp on retina displays. */
  .brand__mark {
    width: 84px;
    height: auto;
    background: transparent;
  }

  @media (max-width: 600px) {
    .brand__mark {
      width: 64px;
    }
  }

  .brand__name {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    line-height: 1.02;
    letter-spacing: -0.02em;
    color: var(--ink-900);
  }

  .brand__light {
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--ink-600);
  }

  .brand__bold {
    font-size: 1.0625rem;
    font-weight: 700;
  }

  @media (max-width: 400px) {
    .brand__name {
      display: none;
    }
  }

  /* ---- Nav -------------------------------------------------------------- */

  .nav__list {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav__item {
    position: static;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.55rem 0.8rem;
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-700);
    text-decoration: none;
    border-radius: var(--radius);
    white-space: nowrap;
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease);
  }

  .nav__link:hover,
  .nav__item.is-open > .nav__link {
    color: var(--ge-red-ink);
    background: var(--ink-050);
  }

  .nav__link[aria-current='page'] {
    color: var(--ink-900);
    font-weight: 600;
  }

  .nav__caret {
    transition: transform var(--dur) var(--ease);
    color: var(--ink-400);
  }

  .nav__item.is-open .nav__caret {
    transform: rotate(180deg);
  }

  @media (max-width: 1080px) {
    .nav {
      display: none;
    }
  }

  /* ---- Mega menu --------------------------------------------------------
     Full-bleed panel anchored to the header rather than the trigger, so the
     columns line up with the page grid instead of floating.
     -------------------------------------------------------------------- */

  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--white);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease),
      visibility var(--dur) var(--ease);
  }

  .nav__item.is-open .mega {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .mega__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: var(--sp-8);
    padding-block: var(--sp-7);
  }

  .mega__cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--sp-7);
  }

  .mega__col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.15rem;
  }

  .mega__title {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-400);
    margin: 0 0 var(--sp-3);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--border);
  }

  .mega__link {
    display: block;
    padding: 0.5rem 0.6rem;
    margin-left: -0.6rem;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background var(--dur) var(--ease);
  }

  .mega__link:hover {
    background: var(--ink-050);
  }

  .mega__label {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ink-900);
  }

  .mega__label :global(svg) {
    opacity: 0;
    transform: translateX(-4px);
    color: var(--ge-red-ink);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .mega__link:hover .mega__label :global(svg) {
    opacity: 1;
    transform: none;
  }

  .mega__desc {
    display: block;
    font-size: var(--fs-xs);
    color: var(--ink-500);
    line-height: 1.4;
    margin-top: 0.15rem;
  }

  .mega__feature {
    background: var(--ink-900);
    color: #fff;
    padding: var(--sp-6);
    border-top: 3px solid var(--ge-red);
    align-self: start;
  }

  .mega__feature-title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    margin: 0 0 var(--sp-3);
  }

  .mega__feature-text {
    font-size: var(--fs-xs);
    color: var(--ink-300);
    line-height: 1.55;
    margin: 0 0 var(--sp-4);
  }

  .mega__feature .link-arrow {
    color: #ff6b66;
  }

  @media (max-width: 1260px) {
    .mega__inner {
      grid-template-columns: minmax(0, 1fr);
    }
    .mega__feature {
      display: none;
    }
  }

  /* ---- Actions ---------------------------------------------------------- */

  .bar__actions {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex: none;
  }

  .burger {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: -0.6rem;
    color: var(--ink-800);
    border-radius: var(--radius);
  }

  .burger:hover {
    background: var(--ink-050);
  }

  @media (max-width: 1080px) {
    .burger {
      display: inline-flex;
    }
  }

  @media (max-width: 560px) {
    .cta-quote {
      display: none;
    }
  }

  /* ---- Mobile drawer ----------------------------------------------------- */

  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(410px, 92vw);
    z-index: var(--z-drawer);
    background: var(--white);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform var(--dur-slow) var(--ease-out);
    box-shadow: var(--shadow-lg);
    overscroll-behavior: contain;
  }

  .drawer[hidden] {
    display: flex;
  }

  .drawer.is-open {
    transform: none;
  }

  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-4) var(--sp-5);
    border-bottom: 1px solid var(--border);
    flex: none;
  }

  .drawer__title {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-500);
  }

  .drawer__close {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    margin-right: -0.5rem;
    color: var(--ink-800);
  }

  .drawer__nav {
    flex: 1;
    overflow-y: auto;
    padding: var(--sp-3) 0;
    -webkit-overflow-scrolling: touch;
  }

  .drawer__nav > ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .drawer__top,
  .drawer__toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    gap: var(--sp-3);
    padding: 0.95rem var(--sp-5);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    color: var(--ink-900);
    text-decoration: none;
    text-align: left;
  }

  .drawer__toggle :global(svg) {
    color: var(--ink-400);
    transition: transform var(--dur) var(--ease);
    flex: none;
  }

  .drawer__toggle[aria-expanded='true'] :global(svg) {
    transform: rotate(180deg);
  }

  .drawer__panel {
    padding: 0 var(--sp-5) var(--sp-5);
    background: var(--ink-050);
    border-block: 1px solid var(--border);
  }

  .drawer__panel[hidden] {
    display: none;
  }

  .drawer__overview {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: var(--sp-4) 0 var(--sp-2);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--ge-red-ink);
    text-decoration: none;
  }

  .drawer__sub {
    padding-top: var(--sp-4);
  }

  .drawer__subtitle {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-400);
    margin: 0 0 var(--sp-2);
  }

  .drawer__sub ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  .drawer__sub a {
    display: block;
    padding: 0.5rem 0;
    font-size: var(--fs-sm);
    color: var(--ink-700);
    text-decoration: none;
  }

  .drawer__sub a:hover {
    color: var(--ge-red-ink);
  }

  .drawer__foot {
    flex: none;
    padding: var(--sp-5);
    border-top: 1px solid var(--border);
    display: grid;
    gap: var(--sp-3);
  }

  .drawer__contact {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-sm);
    color: var(--ink-600);
    text-decoration: none;
  }

  .drawer-scrim {
    position: fixed;
    inset: 0;
    z-index: calc(var(--z-drawer) - 1);
    background: rgba(11, 13, 16, 0.5);
    opacity: 0;
    transition: opacity var(--dur) var(--ease);
  }

  .drawer-scrim[hidden] {
    display: block;
    pointer-events: none;
  }

  .drawer-scrim.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  :global(body.drawer-open) {
    overflow: hidden;
  }
</style>

<script>
  /* ------------------------------------------------------------------------
   * Header behaviour: sticky shadow, desktop mega menu, mobile drawer.
   * Written without a framework — this is the only interactive chrome on the
   * site and it does not justify shipping a runtime.
   * --------------------------------------------------------------------- */

  const header = document.querySelector<HTMLElement>('[data-header]');

  /* Sticky shadow ------------------------------------------------------- */
  if (header) {
    const onScroll = () => header.classList.toggle('is-stuck', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  /* Mega menu ------------------------------------------------------------
   * Opens on hover for pointer users and on click/Enter for everyone else,
   * with a small close delay so diagonal mouse travel into the panel does not
   * dismiss it.
   */
  const megaItems = Array.from(document.querySelectorAll<HTMLElement>('.nav__item.has-mega'));
  let closeTimer: number | undefined;

  const closeAll = (except?: HTMLElement) => {
    megaItems.forEach((item) => {
      if (item === except) return;
      item.classList.remove('is-open');
      item.querySelector('.nav__link')?.setAttribute('aria-expanded', 'false');
    });
  };

  const open = (item: HTMLElement) => {
    window.clearTimeout(closeTimer);
    closeAll(item);
    item.classList.add('is-open');
    item.querySelector('.nav__link')?.setAttribute('aria-expanded', 'true');
  };

  const scheduleClose = () => {
    window.clearTimeout(closeTimer);
    closeTimer = window.setTimeout(() => closeAll(), 140);
  };

  megaItems.forEach((item) => {
    const trigger = item.querySelector<HTMLAnchorElement>('.nav__link');

    item.addEventListener('mouseenter', () => open(item));
    item.addEventListener('mouseleave', scheduleClose);

    // Keyboard/touch: first activation opens the panel rather than navigating.
    trigger?.addEventListener('click', (event) => {
      if (!item.classList.contains('is-open')) {
        event.preventDefault();
        open(item);
      }
    });

    // Close once focus leaves the group entirely.
    item.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (!next || !item.contains(next)) scheduleClose();
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAll();
  });

  /* Mobile drawer -------------------------------------------------------- */
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const scrim = document.querySelector<HTMLElement>('[data-drawer-scrim]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-drawer-open]');
  const closeBtn = document.querySelector<HTMLElement>('[data-drawer-close]');

  const setDrawer = (isOpen: boolean) => {
    if (!drawer || !scrim) return;
    drawer.classList.toggle('is-open', isOpen);
    scrim.classList.toggle('is-open', isOpen);
    document.body.classList.toggle('drawer-open', isOpen);
    openBtn?.setAttribute('aria-expanded', String(isOpen));
    if (isOpen) drawer.querySelector<HTMLElement>('.drawer__close')?.focus();
    else openBtn?.focus();
  };

  openBtn?.addEventListener('click', () => setDrawer(true));
  closeBtn?.addEventListener('click', () => setDrawer(false));
  scrim?.addEventListener('click', () => setDrawer(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && drawer?.classList.contains('is-open')) setDrawer(false);
  });

  /* Drawer accordions ---------------------------------------------------- */
  document.querySelectorAll<HTMLButtonElement>('.drawer__toggle').forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const panel = toggle.nextElementSibling as HTMLElement | null;
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      if (panel) panel.hidden = expanded;
    });
  });
</script>

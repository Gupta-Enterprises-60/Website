/**
 * Inline SVG icon set.
 *
 * Icons are drawn on a 24×24 grid with a 2px stroke and round caps/joins, in
 * the Lucide idiom. They are inlined rather than loaded from a sprite or a
 * font so there is no extra request and no FOUC — and because only the icons
 * actually referenced end up in the HTML.
 */
export interface Props {
  name: string;
  size?: number | string;
  stroke?: number;
  class?: string;
  /** Provide when the icon carries meaning on its own; otherwise it is hidden. */
  title?: string;
}


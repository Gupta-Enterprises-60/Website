const dims = typeof size === 'number' ? `${size}` : size;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={dims}
  height={dims}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  focusable="false"
>
  {title && <title>{title}</title>}
  <Fragment set:html={d} />
</svg>

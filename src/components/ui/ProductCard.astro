---
import SmartImage from './SmartImage.astro';
import Icon from './Icon.astro';
import { categoryById } from '../../lib/site';
import { firstImage } from '../../lib/images';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  product: CollectionEntry<'products'>;
  sizes?: string;
  loading?: 'lazy' | 'eager';
}

const { product, sizes = '(max-width:640px) 92vw, (max-width:1000px) 45vw, 400px', loading = 'lazy' } =
  Astro.props;
const d = product.data;
const cover = firstImage(d.images);
const category = categoryById(d.category);
---

<article class="p-card">
  <a href={`/products/${product.id}`} class="p-card__link">
    <div class="p-card__media">
      <SmartImage
        src={cover?.src}
        alt={cover?.alt ?? d.name}
        ratio="4 / 3"
        sizes={sizes}
        loading={loading}
        width={800}
        class="p-card__img"
        placeholderLabel="Product photo"
        placeholderHint={d.placeholderHint}
        placeholderIcon="box"
      />
      {
        (d.featured || d.isNew) && (
          <div class="p-card__flags">
            {d.isNew && <span class="chip chip--accent">New</span>}
            {d.featured && !d.isNew && <span class="chip chip--dark">Featured</span>}
          </div>
        )
      }
    </div>

    <div class="p-card__body">
      <p class="p-card__meta">
        <span class="mono">{d.code}</span>
        {category && <><span class="p-card__dot" aria-hidden="true">·</span><span>{category.shortName}</span></>}
      </p>
      <h3 class="p-card__title">{d.name}</h3>
      <p class="p-card__text">{d.summary}</p>
      <span class="link-arrow p-card__cta">
        View details
        <Icon name="arrow-right" size={15} />
      </span>
    </div>
  </a>
</article>

<style>
  .p-card {
    display: flex;
    background: var(--white);
    border: 1px solid var(--border);
    border-top: 3px solid var(--ge-red);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .p-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .p-card__link {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
    color: inherit;
  }

  .p-card__media {
    position: relative;
    overflow: hidden;
    background: var(--ink-100);
  }

  .p-card__media :global(.p-card__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .p-card__link:hover .p-card__media :global(.p-card__img) {
    transform: scale(1.035);
  }

  .p-card__flags {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    display: flex;
    gap: 0.4rem;
  }

  .p-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding: var(--sp-5);
    flex: 1;
  }

  .p-card__meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--fs-xs);
    color: var(--ink-500);
    margin: 0;
  }

  .p-card__meta .mono {
    color: var(--ge-red-ink);
    font-weight: 500;
  }

  .p-card__dot {
    color: var(--ink-300);
  }

  .p-card__title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  .p-card__text {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .p-card__cta {
    margin-top: auto;
    padding-top: var(--sp-3);
  }
</style>

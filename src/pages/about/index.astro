---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import SectionHead from '../../components/sections/SectionHead.astro';
import CTABand from '../../components/sections/CTABand.astro';
import Icon from '../../components/ui/Icon.astro';
import SmartImage from '../../components/ui/SmartImage.astro';

import company from '../../data/company.json';
import infrastructure from '../../data/infrastructure.json';
import { yearsInOperation } from '../../lib/site';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'About us' }];

const heroStats = [
  { label: 'Established', value: '2004' },
  { label: 'Manufacturing units', value: '2' },
  { label: 'Power presses', value: '35' },
  { label: 'Team members', value: '50+' },
];

const maxGrowth = Math.max(...company.growth.series.map((s) => s.value));
---

<BaseLayout
  title="About Us — Precision Components, Faridabad"
  description="ISO 9001:2015 certified manufacturer of precision sheet-metal and tubular components in Faridabad. 35 presses, in-house tool room, 8+ Tier-1 customers."
  breadcrumbs={crumbs}
>
  <PageHero
    kicker="Company overview"
    title="A precision partner the automotive industry trusts"
    lead={company.intro}
    breadcrumbs={crumbs}
    stats={heroStats}
  />

  <!-- ===== Positioning ===== -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">What we do</p>
          <h2>Components, and the tools that make them</h2>
        </div>
        <div data-reveal data-reveal-delay="80">
          <p class="lead">{company.positioning}</p>
          <p class="about__body">
            Founded in Faridabad in {2004}, Gupta Enterprises manufactures sheet-metal, tubular and
            deep-draw components for automotive OEMs and Tier-1 suppliers — and designs and builds
            the dies, fixtures and gauges that produce them. A fully equipped in-house tool room
            keeps quality, cost and lead time under our control rather than a supplier's.
          </p>
          <p class="about__body">
            From a 35-press shop floor to laser cutting and CNC machining, we deliver OEM and custom
            components on time and to specification — with every part inspected against your drawing
            before it is packed.
          </p>
          <div class="btn-row about__ctas">
            <a href="/about/our-story" class="btn btn--outline">Read our story</a>
            <a href="/capabilities" class="btn btn--outline">Explore capabilities</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Vision & mission ===== -->
  <section class="section section--sunken">
    <div class="container">
      <SectionHead kicker="Vision & mission" title="What drives us forward" />

      <div class="split split--balanced vm">
        <div class="vm__vision" data-reveal>
          <p class="vm__label">Vision</p>
          <p class="vm__text">{company.vision}</p>
        </div>

        <div data-reveal data-reveal-delay="80">
          <p class="vm__label">Mission</p>
          <ul class="vm__list">
            {
              company.missionPoints.map((point) => (
                <li>
                  <span class="vm__bar" aria-hidden="true" />
                  <span>{point}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Values ===== -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Core values"
        title="The principles behind every part we make"
        lead="Six commitments that decide how we quote, how we manufacture and what we will not agree to."
      />
      <ul class="values">
        {
          company.values.map((value, i) => (
            <li class="value" data-reveal data-reveal-delay={(i % 3) * 60}>
              <Icon name={value.icon} size={22} stroke={1.75} class="value__icon" />
              <h3 class="value__title">{value.title}</h3>
              <p class="value__text">{value.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===== Growth ===== -->
  <section class="section on-dark">
    <div class="container">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">Growth & performance</p>
          <h2>Steady, profitable growth</h2>
          <p class="lead growth__lead">
            Three consecutive years of turnover growth, driven by repeat programmes rather than
            one-off wins. {company.growth.footnote}
          </p>

          <ul class="growth__figures">
            <li>
              <span class="growth__figure">₹25.35 Cr</span>
              <span class="growth__caption">FY 2022–23 turnover</span>
            </li>
            <li>
              <span class="growth__figure">+23%</span>
              <span class="growth__caption">Growth over two years</span>
            </li>
            <li>
              <span class="growth__figure">{yearsInOperation()} yrs</span>
              <span class="growth__caption">In continuous operation</span>
            </li>
          </ul>
        </div>

        <figure class="chart" data-reveal data-reveal-delay="80">
          <figcaption class="chart__title">{company.growth.caption}</figcaption>
          <ul class="chart__bars">
            {
              company.growth.series.map((point, i) => (
                <li class="chart__item">
                  <span class="chart__value mono">₹{point.value.toFixed(2)}</span>
                  <span
                    class:list={['chart__bar', i === company.growth.series.length - 1 && 'is-latest']}
                    style={`--h:${(point.value / maxGrowth) * 100}%`}
                  />
                  <span class="chart__period">{point.period}</span>
                </li>
              ))
            }
          </ul>
        </figure>
      </div>
    </div>
  </section>

  <!-- ===== Facility snapshot ===== -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Infrastructure"
        title="Where the work happens"
        lead={infrastructure.intro}
        link={{ label: 'Full infrastructure detail', href: '/infrastructure' }}
      />

      <div class="units">
        {
          infrastructure.units.map((unit, i) => (
            <article class="unit" data-reveal data-reveal-delay={i * 80}>
              <div class="unit__media">
                <SmartImage
                  src=""
                  alt=""
                  ratio="16 / 10"
                  placeholderLabel={`${unit.name} — ${unit.purpose}`}
                  placeholderHint="Wide interior shot showing the floor in use."
                  placeholderIcon="factory"
                />
              </div>
              <div class="unit__body">
                <p class="unit__name">{unit.name}</p>
                <p class="unit__area">
                  <span>{unit.area}</span> {unit.areaUnit}
                </p>
                <p class="unit__purpose">{unit.purpose}</p>
                <ul class="unit__list">
                  {unit.houses.map((item) => (
                    <li>
                      <Icon name="check" size={15} />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== Future ===== -->
  <section class="section section--sunken">
    <div class="container">
      <SectionHead
        kicker="Future vision"
        title="Where Gupta Enterprises is headed"
        lead="Our aim is to be a trusted manufacturing partner for Indian and international customers alike."
      />
      <div class="grid grid--3">
        {
          company.futureVision.map((item, i) => (
            <div class="card card--accent" data-reveal data-reveal-delay={i * 70}>
              <div class="card__body">
                <Icon name={item.icon} size={24} stroke={1.6} class="future__icon" />
                <h3 class="card__title">{item.title}</h3>
                <p class="card__text">{item.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  .about__body {
    font-size: var(--fs-body);
    color: var(--ink-700);
    line-height: var(--lh-relaxed);
    margin-top: var(--sp-4);
  }

  .about__ctas {
    margin-top: var(--sp-6);
  }

  /* ---- Vision / mission --------------------------------------------------- */

  .vm__label {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ge-red-ink);
    margin: 0 0 var(--sp-4);
  }

  .vm__vision {
    padding-right: clamp(0rem, -2rem + 4vw, 3rem);
  }

  .vm__text {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.05rem + 0.9vw, 1.75rem);
    font-weight: 400;
    line-height: 1.42;
    letter-spacing: var(--tracking-tight);
    color: var(--ink-800);
    margin: 0;
  }

  .vm__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .vm__list li {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: var(--sp-3);
    align-items: start;
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--border);
    font-size: var(--fs-body);
    color: var(--ink-700);
    line-height: 1.6;
  }

  .vm__bar {
    display: block;
    width: 18px;
    height: 3px;
    background: var(--ge-red);
    margin-top: 0.65rem;
  }

  @media (max-width: 900px) {
    .vm__vision {
      padding-right: 0;
      padding-bottom: var(--sp-6);
      border-bottom: 1px solid var(--border);
    }
  }

  /* ---- Values -------------------------------------------------------------- */

  .values {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (max-width: 900px) {
    .values {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .values {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .value {
    background: var(--white);
    padding: var(--sp-6);
  }

  .value__icon {
    color: var(--ge-red-ink);
    margin-bottom: var(--sp-4);
  }

  .value__title {
    font-size: 1.0625rem;
    margin: 0 0 var(--sp-2);
  }

  .value__text {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* ---- Growth chart -------------------------------------------------------- */

  .growth__lead {
    margin-top: var(--sp-5);
    max-width: 52ch;
  }

  .growth__figures {
    list-style: none;
    padding: 0;
    margin: var(--sp-7) 0 0;
    display: grid;
    gap: 1px;
    background: var(--border-on-dark);
    border: 1px solid var(--border-on-dark);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .growth__figures li {
    background: var(--ink-900);
    padding: var(--sp-5) var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .growth__figure {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    color: #fff;
  }

  .growth__caption {
    font-size: var(--fs-xs);
    color: var(--ink-400);
    line-height: 1.4;
  }

  .chart {
    margin: 0;
    border: 1px solid var(--border-on-dark);
    padding: var(--sp-6);
  }

  .chart__title {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-400);
    margin-bottom: var(--sp-7);
  }

  .chart__bars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-5);
    align-items: end;
    list-style: none;
    padding: 0;
    margin: 0;
    min-height: 260px;
  }

  .chart__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: var(--sp-3);
    height: 100%;
  }

  .chart__value {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: #fff;
  }

  .chart__bar {
    display: block;
    width: 100%;
    max-width: 90px;
    height: var(--h);
    background: var(--ink-600);
    min-height: 6px;
  }

  .chart__bar.is-latest {
    background: var(--ge-red);
  }

  .chart__period {
    font-size: var(--fs-xs);
    color: var(--ink-400);
    text-align: center;
    padding-top: var(--sp-2);
    border-top: 1px solid var(--border-on-dark);
    width: 100%;
  }

  /* ---- Units ---------------------------------------------------------------- */

  .units {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-6);
  }

  @media (max-width: 820px) {
    .units {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .unit {
    border: 1px solid var(--border);
    border-top: 3px solid var(--ge-red);
    display: flex;
    flex-direction: column;
  }

  .unit__media :global(img),
  .unit__media :global(.ph) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .unit__body {
    padding: var(--sp-6);
  }

  .unit__name {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ge-red-ink);
    margin: 0 0 var(--sp-2);
  }

  .unit__area {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    margin: 0;
  }

  .unit__area span {
    color: var(--ink-900);
  }

  .unit__purpose {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin: var(--sp-2) 0 var(--sp-5);
  }

  .unit__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
    display: grid;
  }

  .unit__list li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 0.6rem;
    align-items: start;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
    font-size: var(--fs-sm);
    color: var(--ink-700);
    line-height: 1.5;
  }

  .unit__list :global(svg) {
    color: var(--ge-red-ink);
    margin-top: 0.25rem;
  }

  .unit__list li:last-child {
    border-bottom: 0;
  }

  .future__icon {
    color: var(--ge-red-ink);
  }
</style>

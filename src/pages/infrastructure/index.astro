---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import SectionHead from '../../components/sections/SectionHead.astro';
import CTABand from '../../components/sections/CTABand.astro';
import SmartImage from '../../components/ui/SmartImage.astro';
import Icon from '../../components/ui/Icon.astro';
import infrastructure from '../../data/infrastructure.json';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Infrastructure' }];

const machines = await getCollection('machines');
const machineCount = machines.reduce((sum, m) => sum + m.data.quantity, 0);

const groupLabels: Record<string, string> = {
  'press-shop': 'Press shop',
  laser: 'Laser cutting',
  machining: 'Machining',
  welding: 'Welding & SPM',
  'tool-room': 'Tool room',
  'material-handling': 'Material handling',
  power: 'Power backup',
};

const groups = Object.entries(groupLabels).map(([id, label]) => ({
  id,
  label,
  count: machines.filter((m) => m.data.group === id).reduce((s, m) => s + m.data.quantity, 0),
}));
---

<BaseLayout
  title="Infrastructure — Two Units in Faridabad"
  description="1,100 sq yards across two Faridabad units: 35 power presses, laser cutting, CNC/VMC machining, 15 welding stations and 144 kVA standby power."
  breadcrumbs={crumbs}
>
  <PageHero
    kicker="Infrastructure"
    title="Infrastructure built for reliable output"
    lead={infrastructure.intro}
    breadcrumbs={crumbs}
    stats={infrastructure.headline.map((h) => ({
      label: h.label,
      value: h.unit ? `${h.value} ${h.unit}` : h.value,
    }))}
  />

  <!-- ===== Units ===== -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Layout"
        title="Two units, deliberately separated"
        lead="Forming and fabrication in one building, machining, tooling and inspection in the other — so heavy press work never sits next to precision measurement."
      />

      <div class="units">
        {
          infrastructure.units.map((unit, i) => (
            <article class="unit" data-reveal data-reveal-delay={i * 80}>
              <div class="unit__media">
                <SmartImage
                  src=""
                  alt=""
                  ratio="16 / 9"
                  placeholderLabel={`${unit.name} — ${unit.purpose}`}
                  placeholderHint="Wide interior shot down the length of the floor, taken during a shift."
                  placeholderIcon="factory"
                />
              </div>
              <div class="unit__body">
                <div class="unit__head">
                  <p class="unit__name">{unit.name}</p>
                  <p class="unit__area">
                    {unit.area}
                    <span>{unit.areaUnit}</span>
                  </p>
                </div>
                <p class="unit__purpose">{unit.purpose}</p>
                <ul class="unit__list">
                  {unit.houses.map((item) => (
                    <li>
                      <Icon name="check" size={15} />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===== Press capacity ===== -->
  <section class="section on-dark">
    <div class="container">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">Press shop</p>
          <h2>35 power presses, 20 to 250 tonnes</h2>
          <p class="lead press__lead">{infrastructure.pressBreakdown.note}</p>
          <a href="/capabilities/metal-stamping" class="btn btn--outline press__cta">
            Metal stamping capability
            <Icon name="arrow-right" size={17} class="icon-arrow" />
          </a>
        </div>

        <figure class="press" data-reveal="right" data-reveal-delay="80">
          <figcaption class="press__title">{infrastructure.pressBreakdown.caption}</figcaption>
          <dl class="press__rows">
            {
              infrastructure.pressBreakdown.rows.map((row) => (
                <div class:list={['press__row', row.highlight && 'is-highlight']}>
                  <dt class="press__tonnage mono">{row.tonnage}</dt>
                  <dd class="press__count">
                    <span class="mono">{row.count}</span>
                    <span class="press__unit">{row.count === 1 ? 'press' : 'presses'}</span>
                  </dd>
                </div>
              ))
            }
          </dl>
          <p class="press__total">
            <span>Total</span>
            <span class="mono">{infrastructure.pressBreakdown.total} presses</span>
          </p>
        </figure>
      </div>
    </div>
  </section>

  <!-- ===== Equipment overview ===== -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Equipment"
        title={`${machineCount} machines across seven groups`}
        lead="A summary by area. The full list — with capacity, make and application for each machine — is published in full."
        link={{ label: 'Full machine list', href: '/infrastructure/machines' }}
      />

      <ul class="groups">
        {
          groups.map((group, i) => (
            <li data-reveal data-reveal-delay={(i % 4) * 50}>
              <a href={`/infrastructure/machines#${group.id}`}>
                <span class="groups__count">{group.count}</span>
                <span class="groups__label">{group.label}</span>
                <Icon name="arrow-right" size={15} class="groups__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ===== Power ===== -->
  <section class="section section--sunken">
    <div class="container">
      <div class="power" data-reveal>
        <div class="power__figure">
          <Icon name="zap" size={28} stroke={1.6} class="power__icon" />
          <p class="power__value">{infrastructure.power.total}</p>
          <p class="power__label">Total standby generation</p>
          <ul class="power__sets">
            {infrastructure.power.sets.map((set) => <li>{set}</li>)}
          </ul>
        </div>
        <div class="power__body">
          <h2 class="power__title">Grid outages do not become delivery delays</h2>
          <p class="power__text">{infrastructure.power.note}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== See it ===== -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="See the plant"
        title="Photographs, video and a standing invitation"
        lead="The most reliable way to judge a supplier is to walk the floor. Until you can, here is the next best thing."
      />

      <div class="grid grid--3">
        <a href="/infrastructure/gallery" class="see" data-reveal>
          <Icon name="image" size={24} stroke={1.6} class="see__icon" />
          <h3 class="see__title">Factory gallery</h3>
          <p class="see__text">
            Shop floor, machinery, tool room, inspection, warehouse, dispatch and the team.
          </p>
          <span class="link-arrow see__cta">
            View gallery
            <Icon name="arrow-right" size={15} />
          </span>
        </a>

        <a href="/infrastructure/videos" class="see" data-reveal data-reveal-delay="70">
          <Icon name="video" size={24} stroke={1.6} class="see__icon" />
          <h3 class="see__title">Factory videos</h3>
          <p class="see__text">
            Press shop in operation, laser cutting, fixture welding and a full plant walkthrough.
          </p>
          <span class="link-arrow see__cta">
            Watch
            <Icon name="arrow-right" size={15} />
          </span>
        </a>

        <a href="/contact" class="see see--accent" data-reveal data-reveal-delay="140">
          <Icon name="map-pin" size={24} stroke={1.6} class="see__icon" />
          <h3 class="see__title">Visit us</h3>
          <p class="see__text">
            An hour from South Delhi. Several of our Tier-1 relationships began with a plant visit.
          </p>
          <span class="link-arrow see__cta">
            Arrange a visit
            <Icon name="arrow-right" size={15} />
          </span>
        </a>
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  /* ---- Units ------------------------------------------------------------------- */

  .units {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-6);
  }

  @media (max-width: 820px) {
    .units {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .unit {
    border: 1px solid var(--border);
    border-top: 3px solid var(--ge-red);
    display: flex;
    flex-direction: column;
  }

  .unit__media :global(img),
  .unit__media :global(.ph) {
    width: 100%;
    object-fit: cover;
  }

  .unit__body {
    padding: var(--sp-6);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .unit__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
  }

  .unit__name {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ge-red-ink);
    margin: 0;
  }

  .unit__area {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.3vw, 2.125rem);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .unit__area span {
    font-size: 0.5em;
    font-weight: 500;
    color: var(--ink-500);
    margin-left: 0.25rem;
    letter-spacing: 0;
  }

  .unit__purpose {
    font-size: var(--fs-body);
    color: var(--ink-800);
    font-weight: 500;
    margin: var(--sp-3) 0 var(--sp-5);
  }

  .unit__list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .unit__list li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 0.6rem;
    align-items: start;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
    font-size: var(--fs-sm);
    color: var(--ink-700);
    line-height: 1.5;
  }

  .unit__list li:last-child {
    border-bottom: 0;
  }

  .unit__list :global(svg) {
    color: var(--ge-red-ink);
    margin-top: 0.25rem;
  }

  /* ---- Press ---------------------------------------------------------------------- */

  .press__lead {
    margin-top: var(--sp-5);
    max-width: 50ch;
  }

  .press__cta {
    margin-top: var(--sp-6);
  }

  .press {
    margin: 0;
    border: 1px solid var(--border-on-dark);
    padding: var(--sp-6);
  }

  .press__title {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-400);
    margin-bottom: var(--sp-5);
  }

  .press__rows {
    margin: 0;
  }

  .press__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border-on-dark);
  }

  .press__tonnage {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: #fff;
  }

  .press__count {
    margin: 0;
    font-size: var(--fs-sm);
    color: var(--ink-300);
    text-align: right;
  }

  .press__unit {
    margin-left: 0.35rem;
    color: var(--ink-400);
  }

  /* The 250 T line is the one buyers scan for — it sets the ceiling on what
     the shop can take on. */
  .press__row.is-highlight .press__tonnage,
  .press__row.is-highlight .press__count {
    color: #ff6b66;
  }

  .press__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: var(--sp-4) 0 0;
    padding-top: var(--sp-4);
    border-top: 2px solid var(--border-on-dark);
    font-size: var(--fs-sm);
    color: var(--ink-400);
  }

  .press__total .mono {
    color: #fff;
    font-weight: 500;
  }

  /* ---- Equipment groups --------------------------------------------------------------- */

  .groups {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (max-width: 1000px) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .groups {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .groups a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16px;
    grid-template-rows: auto auto;
    gap: 0.2rem var(--sp-3);
    align-items: center;
    height: 100%;
    padding: var(--sp-5);
    background: var(--white);
    text-decoration: none;
    color: inherit;
    transition: background var(--dur) var(--ease);
  }

  .groups a:hover {
    background: var(--ink-050);
  }

  .groups__count {
    grid-column: 1;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
    color: var(--ink-900);
    line-height: 1;
  }

  .groups__label {
    grid-column: 1;
    font-size: var(--fs-sm);
    color: var(--text-muted);
  }

  .groups__arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--ink-300);
    transition: transform var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .groups a:hover .groups__arrow {
    color: var(--ge-red-ink);
    transform: translateX(3px);
  }

  /* ---- Power -------------------------------------------------------------------------- */

  .power {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 3vw, 4rem);
    align-items: center;
    padding: clamp(2rem, 1.4rem + 2.4vw, 3.5rem);
    background: var(--ink-900);
    color: #fff;
    border-left: 4px solid var(--ge-red);
  }

  @media (max-width: 760px) {
    .power {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .power__icon {
    color: #ff6b66;
    margin-bottom: var(--sp-4);
  }

  .power__value {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 1.9rem + 2.6vw, 3.75rem);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    margin: 0;
  }

  .power__label {
    font-size: var(--fs-sm);
    color: var(--ink-400);
    margin: var(--sp-2) 0 var(--sp-4);
  }

  .power__sets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.35rem;
    border-top: 1px solid var(--border-on-dark);
    padding-top: var(--sp-4);
  }

  .power__sets li {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--ink-300);
  }

  .power__title {
    color: #fff;
    font-size: var(--fs-h3);
    margin: 0 0 var(--sp-4);
  }

  .power__text {
    font-size: var(--fs-lead);
    color: var(--ink-300);
    line-height: var(--lh-body);
    margin: 0;
    max-width: 62ch;
  }

  /* ---- See it ------------------------------------------------------------------------- */

  .see {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    height: 100%;
    padding: var(--sp-6);
    background: var(--white);
    border: 1px solid var(--border);
    border-top: 3px solid var(--ge-red);
    text-decoration: none;
    color: inherit;
    transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .see:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .see--accent {
    background: var(--ink-050);
  }

  .see__icon {
    color: var(--ge-red-ink);
    margin-bottom: var(--sp-3);
  }

  .see__title {
    font-size: var(--fs-h4);
    margin: 0;
  }

  .see__text {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  .see__cta {
    margin-top: auto;
    padding-top: var(--sp-4);
  }
</style>

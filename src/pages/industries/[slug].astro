---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import SectionHead from '../../components/sections/SectionHead.astro';
import CTABand from '../../components/sections/CTABand.astro';
import ProductCard from '../../components/ui/ProductCard.astro';
import SmartImage from '../../components/ui/SmartImage.astro';
import Icon from '../../components/ui/Icon.astro';

export async function getStaticPaths() {
  const industries = await getCollection('industries');
  return industries.map((industry) => ({ params: { slug: industry.id }, props: { industry } }));
}

const { industry } = Astro.props as { industry: CollectionEntry<'industries'> };
const d = industry.data;

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Industries', href: '/industries' },
  { label: d.title },
];

const allCapabilities = await getCollection('capabilities');
const capabilities = d.capabilitiesUsed
  .map((id) => allCapabilities.find((c) => c.id === id))
  .filter(Boolean) as CollectionEntry<'capabilities'>[];

const products = (await getCollection('products'))
  .filter((p) => p.data.industries.includes(industry.id))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const others = (await getCollection('industries'))
  .filter((i) => i.id !== industry.id)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title={d.seo?.title ?? `${d.title} Components`}
  description={d.seo?.description ?? d.summary}
  breadcrumbs={crumbs}
>
  <PageHero
    kicker={d.kicker}
    title={d.title}
    lead={d.intro}
    breadcrumbs={crumbs}
    stats={[
      { label: 'Status', value: d.status },
      { label: 'Component types', value: String(d.componentTypes.length) },
      { label: 'Capabilities applied', value: String(capabilities.length) },
    ]}
  />

  <!-- ===== Body ===== -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">Our position</p>
          <h2>{d.core ? 'Where we have a record' : 'What we bring — and what we do not'}</h2>
          <div class="status-card">
            <Icon
              name={d.core ? 'check-circle' : 'compass'}
              size={20}
              stroke={1.7}
              class="status-card__icon"
            />
            <div>
              <p class="status-card__label">{d.status}</p>
              <p class="status-card__text">
                {
                  d.core
                    ? 'We supply this sector today, in volume, to repeat multi-year customers.'
                    : 'We have the process capability and quality discipline. We would rather you evaluate us on a trial part than on a claim of sector experience we do not have.'
                }
              </p>
            </div>
          </div>
        </div>

        <div class="ind-body" data-reveal data-reveal-delay="80">
          {d.body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== Components ===== -->
  <section class="section section--sunken">
    <div class="container">
      <SectionHead
        kicker="Component types"
        title={`What we make for ${d.title.toLowerCase()}`}
        lead="Representative part types. If your component is not listed, it is very likely still within our process range."
      />

      <div class="split">
        <ul class="types" data-reveal>
          {
            d.componentTypes.map((type) => (
              <li>
                <Icon name="check" size={16} />
                <span>{type}</span>
              </li>
            ))
          }
        </ul>

        <figure class="ind-figure" data-reveal data-reveal-delay="80">
          <SmartImage
            src={d.image?.src}
            alt={d.image?.alt ?? ''}
            ratio="4 / 3"
            width={900}
            sizes="(max-width:900px) 92vw, 560px"
            placeholderLabel={`${d.title} components`}
            placeholderHint="Photograph a representative part or group of parts for this sector."
            placeholderIcon={d.icon}
          />
          {d.image?.caption && <figcaption>{d.image.caption}</figcaption>}
        </figure>
      </div>
    </div>
  </section>

  <!-- ===== Capabilities applied ===== -->
  {
    capabilities.length > 0 && (
      <section class="section">
        <div class="container">
          <SectionHead
            kicker="Capabilities applied"
            title="The processes behind these parts"
            link={{ label: 'All capabilities', href: '/capabilities' }}
          />
          <div class="grid grid--3">
            {capabilities.map((capability, i) => (
              <a
                href={`/capabilities/${capability.id}`}
                class="cap-link"
                data-reveal
                data-reveal-delay={(i % 3) * 60}
              >
                <Icon name={capability.data.icon} size={22} stroke={1.7} class="cap-link__icon" />
                <span class="cap-link__title">
                  {capability.data.navTitle ?? capability.data.title}
                  {!capability.data.inHouse && <em>Partner-managed</em>}
                </span>
                <span class="cap-link__text">{capability.data.summary}</span>
                <span class="link-arrow cap-link__cta">
                  Explore
                  <Icon name="arrow-right" size={14} />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ===== Products ===== -->
  {
    products.length > 0 && (
      <section class="section section--sunken">
        <div class="container">
          <SectionHead
            kicker="From the catalog"
            title="Components we already make for this sector"
            link={{ label: 'Full catalog', href: '/products' }}
          />
          <div class="grid grid--3">
            {products.map((product, i) => (
              <div data-reveal data-reveal-delay={(i % 3) * 70}>
                <ProductCard product={product} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- ===== Other industries ===== -->
  <section class="section">
    <div class="container">
      <SectionHead kicker="Explore further" title="Other industries" />
      <ul class="others" data-reveal>
        {
          others.map((other) => (
            <li>
              <a href={`/industries/${other.id}`}>
                <Icon name={other.data.icon} size={19} stroke={1.7} />
                <span>{other.data.title}</span>
                <Icon name="arrow-right" size={15} class="others__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  .status-card {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: var(--sp-3);
    align-items: start;
    margin-top: var(--sp-5);
    padding: var(--sp-5);
    background: var(--ink-050);
    border-left: 3px solid var(--ge-red);
  }

  .status-card__icon {
    color: var(--ge-red-ink);
    margin-top: 0.15rem;
  }

  .status-card__label {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-900);
    margin: 0 0 var(--sp-2);
  }

  .status-card__text {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .ind-body p {
    font-size: var(--fs-lead);
    line-height: var(--lh-relaxed);
    color: var(--ink-700);
    max-width: 66ch;
  }

  .ind-body p + p {
    margin-top: var(--sp-4);
  }

  /* ---- Component types ---------------------------------------------------------- */

  .types {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .types li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 0.7rem;
    align-items: start;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
    font-size: var(--fs-body);
    color: var(--ink-700);
    line-height: 1.5;
  }

  .types :global(svg) {
    color: var(--ge-red-ink);
    margin-top: 0.25rem;
  }

  .ind-figure {
    margin: 0;
  }

  .ind-figure :global(img),
  .ind-figure :global(.ph) {
    width: 100%;
    object-fit: cover;
  }

  .ind-figure figcaption {
    font-size: var(--fs-xs);
    color: var(--text-subtle);
    margin-top: var(--sp-3);
  }

  /* ---- Capability links ----------------------------------------------------------- */

  .cap-link {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    height: 100%;
    padding: var(--sp-5);
    background: var(--white);
    border: 1px solid var(--border);
    border-top: 3px solid var(--ge-red);
    text-decoration: none;
    color: inherit;
    transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .cap-link:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .cap-link__icon {
    color: var(--ge-red-ink);
    margin-bottom: var(--sp-3);
  }

  .cap-link__title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .cap-link__title em {
    display: block;
    font-style: normal;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-400);
    margin-top: 0.2rem;
  }

  .cap-link__text {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.6;
  }

  .cap-link__cta {
    margin-top: auto;
    padding-top: var(--sp-4);
  }

  /* ---- Other industries -------------------------------------------------------------- */

  .others {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media (max-width: 1000px) {
    .others {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .others {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .others a {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) 16px;
    align-items: center;
    gap: 0.7rem;
    padding: var(--sp-5) var(--sp-4);
    background: var(--white);
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-800);
    text-decoration: none;
    height: 100%;
    transition: background var(--dur) var(--ease);
  }

  .others a:hover {
    background: var(--ink-050);
    color: var(--ge-red-ink);
  }

  .others :global(svg) {
    color: var(--ge-red-ink);
  }

  .others__arrow {
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
    color: currentColor;
  }

  .others a:hover .others__arrow {
    opacity: 1;
    transform: none;
  }
</style>

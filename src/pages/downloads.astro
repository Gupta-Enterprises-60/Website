---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import SectionHead from '../components/sections/SectionHead.astro';
import CTABand from '../components/sections/CTABand.astro';
import Icon from '../components/ui/Icon.astro';
import downloads from '../data/downloads.json';

const crumbs = [{ label: 'Home', href: '/' }, { label: 'Downloads' }];

const featured = downloads.items.filter((item) => item.featured);
const others = downloads.items.filter((item) => !item.featured);
---

<BaseLayout
  title="Downloads — Company Profile & Literature"
  description="Download the Gupta Enterprises company profile: capabilities, machine list, infrastructure, quality process, certifications and financial summary. No form, no gate."
  breadcrumbs={crumbs}
>
  <PageHero
    kicker="Downloads"
    title="Literature for your supplier file"
    lead={downloads.intro}
    breadcrumbs={crumbs}
    align="wide"
  />

  <!-- ===== Featured download ===== -->
  {
    featured.map((item) => (
      <section class="section">
        <div class="container">
          <article class="feature" data-reveal>
            <div class="feature__doc" aria-hidden="true">
              <span class="feature__format">{item.format}</span>
              <Icon name="file-text" size={44} stroke={1.2} class="feature__icon" />
              <span class="feature__pages">{item.pages}</span>
            </div>

            <div class="feature__body">
              <p class="eyebrow">{item.category} literature</p>
              <h2 class="feature__title">{item.title}</h2>
              <p class="feature__text">{item.description}</p>

              <ul class="feature__meta">
                <li>
                  <span>Format</span>
                  <span class="mono">{item.format}</span>
                </li>
                <li>
                  <span>Size</span>
                  <span class="mono">{item.sizeLabel}</span>
                </li>
                <li>
                  <span>Length</span>
                  <span class="mono">{item.pages}</span>
                </li>
                <li>
                  <span>Updated</span>
                  <span class="mono">{item.updated}</span>
                </li>
              </ul>

              <div class="btn-row">
                <a href={item.file} class="btn btn--primary btn--lg" download>
                  <Icon name="download" size={18} />
                  Download {item.format}
                </a>
                <a href={item.file} class="btn btn--outline btn--lg" target="_blank" rel="noopener">
                  View in browser
                </a>
              </div>

              <p class="feature__note">
                <Icon name="check-circle" size={15} />
                No form, no email address required. If you need it emailed as an attachment for your
                records, <a href="/contact">ask us</a>.
              </p>
            </div>
          </article>
        </div>
      </section>
    ))
  }

  <!-- ===== Other downloads ===== -->
  {
    others.length > 0 && (
      <section class="section section--sunken">
        <div class="container">
          <SectionHead kicker="More literature" title="Other documents" />
          <ul class="docs">
            {others.map((item, i) => (
              <li data-reveal data-reveal-delay={(i % 3) * 60}>
                <a href={item.file} download>
                  <Icon name="file-text" size={22} stroke={1.6} class="docs__icon" />
                  <span class="docs__body">
                    <span class="docs__title">{item.title}</span>
                    <span class="docs__desc">{item.description}</span>
                    <span class="docs__meta mono">
                      {item.format} · {item.sizeLabel}
                      {item.pages && ` · ${item.pages}`}
                    </span>
                  </span>
                  <Icon name="download" size={18} class="docs__dl" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- ===== On request ===== -->
  <section class="section">
    <div class="container">
      <div class="split">
        <div data-reveal>
          <p class="eyebrow">On request</p>
          <h2>{downloads.onRequest.title}</h2>
          <p class="lead req__lead">{downloads.onRequest.text}</p>
          <div class="btn-row req__ctas">
            <a href="/contact" class="btn btn--primary">
              Request documents
              <Icon name="arrow-right" size={17} class="icon-arrow" />
            </a>
            <a href="/certifications" class="btn btn--outline">Certifications page</a>
          </div>
        </div>

        <div data-reveal data-reveal-delay="80">
          <ul class="req">
            {
              downloads.onRequest.items.map((item) => (
                <li>
                  <Icon name="file-check" size={16} />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style>
  /* ---- Featured ------------------------------------------------------------- */

  .feature {
    display: grid;
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    border: 1px solid var(--border);
    border-top: 3px solid var(--ge-red);
  }

  @media (max-width: 780px) {
    .feature {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .feature__doc {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
    padding: var(--sp-8) var(--sp-5);
    background: var(--ink-900);
    color: #fff;
  }

  .feature__format {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    color: #ff6b66;
  }

  .feature__icon {
    color: rgba(255, 255, 255, 0.85);
  }

  .feature__pages {
    font-size: var(--fs-xs);
    color: var(--ink-400);
  }

  .feature__body {
    padding: clamp(1.75rem, 1.2rem + 2.2vw, 3rem);
  }

  .feature__title {
    font-size: clamp(1.5rem, 1.2rem + 1.6vw, 2.25rem);
    margin: 0 0 var(--sp-4);
  }

  .feature__text {
    font-size: var(--fs-lead);
    color: var(--text-muted);
    line-height: var(--lh-body);
    margin: 0 0 var(--sp-6);
    max-width: 62ch;
  }

  .feature__meta {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-6);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
  }

  @media (max-width: 620px) {
    .feature__meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .feature__meta li {
    background: var(--white);
    padding: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .feature__meta li span:first-child {
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-400);
  }

  .feature__meta li span:last-child {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--ink-900);
  }

  .feature__note {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr);
    gap: 0.6rem;
    align-items: start;
    font-size: var(--fs-xs);
    color: var(--text-subtle);
    line-height: 1.6;
    margin: var(--sp-5) 0 0;
  }

  .feature__note :global(svg) {
    color: var(--ge-red-ink);
    margin-top: 0.15rem;
  }

  .feature__note a {
    color: var(--ge-red-ink);
    font-weight: 500;
  }

  /* ---- Doc list ------------------------------------------------------------- */

  .docs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--sp-4);
  }

  .docs a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--sp-4);
    align-items: center;
    padding: var(--sp-5);
    background: var(--white);
    border: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }

  .docs a:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-md);
  }

  .docs__icon {
    color: var(--ge-red-ink);
  }

  .docs__body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .docs__title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
  }

  .docs__desc {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.55;
  }

  .docs__meta {
    font-size: var(--fs-xs);
    color: var(--text-subtle);
    margin-top: 0.2rem;
  }

  .docs__dl {
    color: var(--ink-400);
  }

  .docs a:hover .docs__dl {
    color: var(--ge-red-ink);
  }

  /* ---- On request ----------------------------------------------------------- */

  .req__lead {
    margin-top: var(--sp-5);
    max-width: 52ch;
  }

  .req__ctas {
    margin-top: var(--sp-6);
  }

  .req {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .req li {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 0.7rem;
    align-items: start;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--border);
    font-size: var(--fs-body);
    color: var(--ink-700);
    line-height: 1.5;
  }

  .req :global(svg) {
    color: var(--ge-red-ink);
    margin-top: 0.2rem;
  }
</style>
